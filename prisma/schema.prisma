// TartibOS — Prisma sxemasi
// mockapi.io'dagi "erkin" JSON strukturasidan farqli o'laroq, bu yerda
// har bir yozuv haqiqiy foreign key orqali o'ziga tegishli foydalanuvchiga
// bog'langan — bu ma'lumotlar izolyatsiyasini server darajasida ta'minlaydi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon'ning pooled (PgBouncer) ulanishi ko'p qisqa so'rovlar uchun yaxshi,
  // lekin Prisma Migrate advisory lock'lar talab qiladi va pooler orqali
  // ba'zan barqaror ishlamaydi. DIRECT_URL — pooler'siz to'g'ridan-to'g'ri
  // ulanish, faqat migratsiyalar shundan foydalanadi.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  ism          String
  email        String   @unique
  passwordHash String
  number       String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Telegram bot integratsiyasi — foydalanuvchi botni ulaguncha ikkalasi ham null
  telegramChatId   String?   @unique
  telegramLinkedAt DateTime?
  // IANA timezone identifikatori (masalan "Asia/Tashkent") — eslatmalar
  // shu vaqt mintaqasiga qarab yuboriladi
  timezone         String    @default("Asia/Tashkent")

  // Goal-asosidagi Level tizimi — bu user.level GLOBAL: har qanday Goal
  // ostidagi istalgan RoadmapStep bajarilganda oshadi. Eski kunlik/haftalik
  // intizom % taqqoslashiga asoslangan "Level Up!" toast bilan ARALASHMAYDI —
  // u alohida, faqat frontendda hisoblanadigan vaqtinchalik hodisa bo'lib
  // qoladi (bu yerda saqlanmaydi).
  level Int @default(1)

  activities Activity[]
  routines   Routine[]
  weeks      Week[]
  missions   Mission[]
  reviews    DailyReview[]
  telegramLinkTokens TelegramLinkToken[]
  goals      Goal[]

  @@map("users")
}

// Foydalanuvchining shaxsiy maqsadi (masalan "Fullstack Developer bo'lish").
// Har bir Goal — Yo'l xaritasi sahifasidagi bitta "tog'"ga mos keladi.
model Goal {
  id          String   @id @default(uuid())
  title       String
  // Agar tayyor andozadan yaratilgan bo'lsa, uning kaliti (masalan
  // "frontend-to-fullstack") — src/data/roadmapTemplates.js'ga qarang.
  // Andozasiz, foydalanuvchi qo'lda yaratgan bo'lsa — null.
  templateKey String?
  status      String   @default("active") // active | completed | archived
  // Yo'l xaritasi sahifasidagi carousel tartibi (kichikdan kattaga)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps  RoadmapStep[]

  @@index([userId])
  @@map("goals")
}

// Bitta Goal ichidagi bosqich — tog'dagi bitta "belgi". Bajarilganda
// user.level +1 bo'ladi va dashboard'dagi unvon shu bosqichning
// stageLabel'iga yangilanadi.
model RoadmapStep {
  id          String    @id @default(uuid())
  title       String
  // Dashboard'da "Level N" ostida ko'rinadigan qisqa unvon
  // (masalan "Junior Backend"). Bo'sh qoldirilsa, Goal.title ishlatiladi.
  stageLabel  String?
  // Tog' bo'ylab pastdan tepaga tartib (0 = eng past bosqich)
  order       Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("roadmap_steps")
}

// Botni hisobga ulash uchun bir martalik, muddati cheklangan token.
// Foydalanuvchi saytda "Telegram botni ulash" tugmasini bosganda yaratiladi,
// deep-link orqali botga uzatiladi va /start buyrug'ida ishlatiladi.
model TelegramLinkToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("telegram_link_tokens")
}

// Profil tarixi — "Profil tahrirlandi", "Parol yangilandi" kabi yozuvlar
model Activity {
  id        String   @id @default(uuid())
  title     String
  color     String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activities")
}

// Odat shabloni. "retired" — versiyalash uchun: eski versiya o'chirilmaydi,
// nofaol qilinadi, tarix saqlanadi.
model Routine {
  id                String   @id @default(uuid())
  title             String
  start             String
  end               String
  category          String?
  priority          String?
  color             String?
  icon              String?
  days              String[] // ["mon","tue",...] — bo'sh bo'lsa, har kuni
  dayPlans          Json? // { mon: "Plan 1", tue: "Plan 2", ... }
  defaultMissions   Json?
  groupId           String?
  active            Boolean  @default(true)
  retired           Boolean  @default(false)
  effectiveFromWeek String?
  versions          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("routines")
}

// Haftalik kuzatuv yozuvi — bitta foydalanuvchi uchun bitta ISO hafta = bitta yozuv
model Week {
  id          String   @id @default(uuid())
  weekId      String // "2026-W33"
  routineId   String   @default("1") // legacy — mockapi arxitekturasidan meros
  statuses    Json     @default("{}") // { mon: "completed" | "partial" | "missed" }
  executions  Json     @default("{}") // { mon: 8 }
  completions Json     @default("{}") // { mon: ["habitKey1", "habitKey2"] }
  scores      Json     @default("{}") // { mon: { habitKey1: 9, habitKey2: 10 } }
  reasons     Json     @default("{}")
  conclusion  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekId])
  @@index([userId])
  @@map("weeks")
}

model Mission {
  id           String    @id @default(uuid())
  title        String
  description  String?
  date         String // "2026-08-15"
  start        String?
  end          String?
  priority     String?
  difficulty   Int?
  estimateMin  Int?
  notes        String?
  scope        String? // "bugun" | "kelgusi" | "haftalik"
  habitGroupId String?
  completed    Boolean   @default(false)
  cancelled    Boolean   @default(false)
  reason       String?
  score        Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  review DailyReview[]

  @@index([userId])
  @@index([userId, date])
  @@map("missions")
}

// Kunlik va haftalik refleksiya. "mode" ikkalasini bitta jadvalda ajratadi:
// daily uchun "date" asosiy kalit, weekly uchun "weekId" asosiy kalit.
// discipline/execution/missionRate/habitConsistency — 1 dan 5 gacha baho
// (frontenddagi ScoreField komponenti bilan mos, 0 = hali belgilanmagan).
model DailyReview {
  id               String   @id @default(uuid())
  mode             String   @default("daily") // "daily" | "weekly"
  date             String
  weekId           String?
  achievement      String?
  mistake          String?
  summary          String?
  nextFocus        String?
  reflection       String?
  discipline       Int?
  execution        Int?
  missionRate      Int?
  habitConsistency Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, mode, date])
  @@index([userId, mode, weekId])
  @@map("daily_reviews")
}
