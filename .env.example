# Neon (yoki boshqa Postgres) dashboardidan olinadi — "Connection string" bo'limi
# Pooled (PgBouncer) ulanish — ilova runtime so'rovlari uchun
DATABASE_URL="postgresql://user:password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct (pooler'siz) ulanish — faqat "prisma migrate" buyruqlari uchun kerak.
# Xuddi shu manzil, faqat hostname'dan "-pooler" qismi olib tashlangan.
DIRECT_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Tasodifiy, uzun va maxfiy satr. Terminalda generatsiya qilish uchun:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-random-secret-here"

JWT_EXPIRES_IN="30d"

PORT=4000
NODE_ENV="development"

# Frontend qaysi manzildan so'rov yuborsa, shunga ruxsat beriladi (CORS)
CORS_ORIGIN="http://localhost:5173,https://tartib-os.vercel.app"

# Telegram bot — ixtiyoriy. @BotFather'dan /newbot orqali olinadi.
# Ikkalasi ham bo'lmasa, bot shunchaki ishga tushmaydi, web API'ga ta'sir qilmaydi.
TELEGRAM_BOT_TOKEN=""
# @ belgisisiz, faqat username (masalan: tartibos_bot)
TELEGRAM_BOT_USERNAME=""
# Telegram Mini App'ning to'liq manzili (frontend'dagi /telegram-app route'i)
MINI_APP_URL="https://tartibos.uz/telegram-app"

# Faqat migrate:mockapi skripti uchun kerak (bir martalik migratsiya)
MOCKAPI_AUTH_URL="https://692ad7047615a15ff24dd69e.mockapi.io/api/v1"
MOCKAPI_ROUTINE_URL="https://6a468bbea268c8be2ce813b4.mockapi.io/api/v1"
MOCKAPI_MISSIONS_URL="https://69f22dd0b15130b97352a73b.mockapi.io/api/v1"

# Frontend manzili — parolni tiklash va email tasdiqlash havolalari shu
# ustiga quriladi (masalan APP_URL/reset-password?token=...). Bo'sh
# qoldirilsa, CORS_ORIGIN'dagi birinchi manzil ishlatiladi.
APP_URL="http://localhost:5173"

# Email yuborish (SMTP) — ixtiyoriy. Sozlanmasa, parolni tiklash/email
# tasdiqlash havolalari xato bermaydi, faqat server logiga yoziladi (dev
# uchun qulay). Masalan Gmail App Password, Brevo, Mailgun SMTP ishlaydi.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TartibOS <no-reply@tartibos.uz>"

# Render (va ko'p bepul hostinglar) chiquvchi SMTP portlarini (25/465/587)
# bloklaydi — shu portlar orqali yuboriladigan email PRODUCTION'DA HECH QACHON
# yetib bormaydi (doim "Connection timeout", faqat serverdagi logda ko'rinadi,
# foydalanuvchiga xato ko'rsatilmaydi). Shuning uchun Render'da SMTP_* o'rniga
# (yoki qo'shimcha ravishda) BREVO_API_KEY sozlang — bu HTTPS orqali ishlaydi
# va hech qachon bloklanmaydi. brevo.com'da ro'yxatdan o'tib, "SMTP & API"
# bo'limidan olinadi. Sozlansa, mailer.js har doim shuni ustun qo'yadi.
BREVO_API_KEY=""

# Google Sign-In — Google Cloud Console > APIs & Services > Credentials'dan
# olinadi (OAuth 2.0 Client ID, turi "Web application"). Frontenddagi
# VITE_GOOGLE_CLIENT_ID bilan BIR XIL bo'lishi shart.
GOOGLE_CLIENT_ID=""