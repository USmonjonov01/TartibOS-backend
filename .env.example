# Neon (yoki boshqa Postgres) dashboardidan olinadi — "Connection string" bo'limi
# Pooled (PgBouncer) ulanish — ilova runtime so'rovlari uchun
DATABASE_URL="postgresql://user:password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct (pooler'siz) ulanish — faqat "prisma migrate" buyruqlari uchun kerak.
# Xuddi shu manzil, faqat hostname'dan "-pooler" qismi olib tashlangan.
DIRECT_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Tasodifiy, uzun va maxfiy satr. Terminalda generatsiya qilish uchun:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-random-secret-here"

JWT_EXPIRES_IN="30d"

PORT=4000
NODE_ENV="development"

# Frontend qaysi manzildan so'rov yuborsa, shunga ruxsat beriladi (CORS)
CORS_ORIGIN="http://localhost:5173,https://tartib-os.vercel.app"

# Telegram bot — ixtiyoriy. @BotFather'dan /newbot orqali olinadi.
# Ikkalasi ham bo'lmasa, bot shunchaki ishga tushmaydi, web API'ga ta'sir qilmaydi.
TELEGRAM_BOT_TOKEN=""
# @ belgisisiz, faqat username (masalan: tartibos_bot)
TELEGRAM_BOT_USERNAME=""
# Telegram Mini App'ning to'liq manzili (frontend'dagi /telegram-app route'i)
MINI_APP_URL="https://tartibos.uz/telegram-app"

# Faqat migrate:mockapi skripti uchun kerak (bir martalik migratsiya)
MOCKAPI_AUTH_URL="https://692ad7047615a15ff24dd69e.mockapi.io/api/v1"
MOCKAPI_ROUTINE_URL="https://6a468bbea268c8be2ce813b4.mockapi.io/api/v1"
MOCKAPI_MISSIONS_URL="https://69f22dd0b15130b97352a73b.mockapi.io/api/v1"